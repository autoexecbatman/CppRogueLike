      "original": "\t\t\tif (name == \"evil\")\n\t\t\t{\n\t\t\t\treturn Morality::EVIL;\n\t\t\t}",
      "mutated": "\t\t\tif (name == \"evil\")\n\t\t\t{\n\t\t\t\treturn Morality::GOOD;\n\t\t\t}",
      "catches": "an alignment parsed back as its opposite on the good/evil axis"
    },
    {
      "file": "src/CreatureClass.h",
      "original": "\t\tif (name == \"monster\")\n\t\t{\n\t\t\treturn CreatureClass::MONSTER;\n\t\t}",
      "mutated": "\t\tif (name == \"monster\")\n\t\t{\n\t\t\treturn CreatureClass::FIGHTER;\n\t\t}",
      "catches": "every monster loading as a fighter, with a fighter's tables"
