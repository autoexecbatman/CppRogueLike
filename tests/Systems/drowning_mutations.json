    },
    {
      "file": "src/Creature.cpp",
      "original": "\tconst int roundsPast = rounds_completed_at(roundEndTime - *airUntilTime);",
      "mutated": "\tconst int roundsPast = 0;",
      "catches": "every check unmodified however long the creature holds out, so the penalty never accumulates"
    },
    {
      "file": "src/Creature.cpp",
      "original": "\tif (has_state(ActorState::CAN_SWIM))\n\t{\n\t\treturn false;\n\t}",
